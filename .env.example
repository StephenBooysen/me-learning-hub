# Me Learning Hub Configuration

# AI/LLM Configuration
# Choose your AI provider: openai, anthropic, etc.
AI_PROVIDER=openai
AI_API_KEY=your_api_key_here
AI_MODEL=gpt-4

# Optional: Anthropic Claude configuration
# CLAUDE_API_KEY=your_claude_api_key_here
# CLAUDE_MODEL=claude-opus-4-5

# Optional: Other LLM provider configurations
# OLLAMA_BASE_URL=http://localhost:11434

# Application Configuration
# Data directory for storing projects, documents, and study plans
# The 'projects' subdirectory will be automatically created here
# Relative paths are resolved from the project root
DATA_DIR=.
MAX_FILE_SIZE=52428800

# Learning Configuration
SPACED_REPETITION_ALGORITHM=sm2
DEFAULT_STUDY_INTENSITY=medium
DEFAULT_SESSION_DURATION=25

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Development
NODE_ENV=development
DEBUG=false
